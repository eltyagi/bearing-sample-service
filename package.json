{
  "name": "bearing-sample-service",
  "version": "1.0.0",
  "private": true,
  "description": "A deterministic TypeScript and Express repository for testing Bearing onboarding.",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "tsx src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
